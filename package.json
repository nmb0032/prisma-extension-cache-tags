{
    "name": "prisma-extension-cache-tags",
    "version": "0.0.0",
    "description": "Redis caching for Prisma with automatic, generational tag invalidation. O(tags), independent of cache keyspace size, no SCAN, transaction-safe.",
    "keywords": [
        "prisma",
        "prisma-extension",
        "redis",
        "cache",
        "invalidation",
        "multi-tenant"
    ],
    "author": "Nick Belvin <nick.belvin@gmail.com>",
    "homepage": "https://github.com/nmb0032/prisma-extension-cache-tags#readme",
    "repository": { "type": "git", "url": "git+https://github.com/nmb0032/prisma-extension-cache-tags.git" },
    "bugs": { "url": "https://github.com/nmb0032/prisma-extension-cache-tags/issues" },
    "license": "MIT",
    "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
    "type": "commonjs",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "bin": {
        "prisma-cache-tags-generator": "./dist/generator.js"
    },
    "typesVersions": {
        "*": {
            "node-redis": [
                "dist/adapters/node-redis.d.ts"
            ],
            "ioredis": [
                "dist/adapters/ioredis.d.ts"
            ]
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./node-redis": {
            "import": {
                "types": "./dist/adapters/node-redis.d.mts",
                "default": "./dist/adapters/node-redis.mjs"
            },
            "require": {
                "types": "./dist/adapters/node-redis.d.ts",
                "default": "./dist/adapters/node-redis.js"
            }
        },
        "./ioredis": {
            "import": {
                "types": "./dist/adapters/ioredis.d.mts",
                "default": "./dist/adapters/ioredis.mjs"
            },
            "require": {
                "types": "./dist/adapters/ioredis.d.ts",
                "default": "./dist/adapters/ioredis.js"
            }
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": "^20.19 || ^22.12 || >=24.0"
    },
    "scripts": {
        "build": "tsup",
        "clean": "rm -rf dist",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "pnpm run test:unit",
        "test:unit": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "test:benchmark:invalidation": "tsx tests/load/invalidation-scaling.ts",
        "test:benchmark:load": "tsx tests/load/load-benchmark.ts",
        "test:e2e": "tsx tests/e2e/package-smoke.ts",
        "db:up": "docker compose up -d --wait",
        "db:down": "docker compose down -v"
    },
    "dependencies": {
        "@prisma/generator-helper": "7.9.1",
        "superjson": "^2.2.6"
    },
    "peerDependencies": {
        "@prisma/client": "^7.2.0",
        "ioredis": "^5.0.0 || ^6.0.0",
        "redis": "^5.0.0 || ^6.0.0"
    },
    "peerDependenciesMeta": {
        "ioredis": {
            "optional": true
        },
        "redis": {
            "optional": true
        }
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@prisma/adapter-pg": "7.9.1",
        "@prisma/client": "7.9.1",
        "@types/node": "^24.7.2",
        "@typescript-eslint/parser": "^8.67.0",
        "eslint": "^9.39.5",
        "ioredis": "^6.0.0",
        "prisma": "7.9.1",
        "publint": "0.3.24",
        "redis": "^6.2.1",
        "tsup": "^8.5.1",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0",
        "vitest": "^4.1.10"
    }
}
