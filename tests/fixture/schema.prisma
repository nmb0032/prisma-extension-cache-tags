generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Widget {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String  @default("")
  parts       Part[]

  @@index([tenantId])
}

model Part {
  id          String @id @default(uuid())
  tenantId    String
  label       String
  description String @default("")
  widgetId    String
  widget      Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
